# Copy to .env (npm run setup does this if missing). Never commit .env.
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=iHouzzUniData
API_PORT=3002
UPLOAD_PORT=3000
CUSTOMER_PORT=4200
EMPLOYEE_PORT=4201
ADMIN_PORT=4202
CUSTOMER_APP_URL=http://localhost:4200
# Generated locally by setup; existing database passwords are not changed.
SESSION_SECRET=
DEMO_PASSWORD=
# Your own payOS merchant credentials are required for real payments.
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=
# SMS is inactive until an approved sender/template is configured.
SMS_PROVIDER=esms
ESMS_API_KEY=
ESMS_SECRET_KEY=
# Exact brand and OTP/CSKH type assigned by eSMS after approval.
ESMS_BRANDNAME=
ESMS_SMS_TYPE=
ESMS_IS_UNICODE=0
# Exact approved text. Replace only the changing PIN with {PIN}.
ESMS_OTP_TEMPLATE=
# Generate independently (at least 32 random characters); do not use either eSMS key here.
PASSWORD_RESET_SECRET=
